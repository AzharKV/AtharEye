{
  "expo": {
    "name": "Athar Eye",
    "slug": "athar-eye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "athareye",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0F12",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.atharrobotics.eye",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "com.atharrobotics.eye",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0C0F12"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0F12",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Athar Eye shows a live camera view behind the LiDAR point cloud while you scan a site."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
