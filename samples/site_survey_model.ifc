ISO-10303-21;
HEADER;
/* OptiSync demo BIM model — neutral sample for the OptiSync (own-app) demo. Small but structurally valid
   IFC4: Project -> Site -> Building -> Storey, with one wall and one floor slab. Pick this from your device
   when uploading a BIM in the OptiSync demo so the report isn't named after the client project. */
FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');
FILE_NAME('site_survey_model.ifc','2026-06-15T09:00:00',('OptiSync'),('Athar Robotics'),'OptiSync 1.0','IFC export','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
#1=IFCPERSON($,'Demo','OptiSync',$,$,$,$,$);
#2=IFCORGANIZATION($,'Athar Robotics',$,$,$);
#3=IFCPERSONANDORGANIZATION(#1,#2,$);
#4=IFCAPPLICATION(#2,'1.0','OptiSync','OptiSync');
#5=IFCOWNERHISTORY(#3,#4,$,.ADDED.,$,$,$,1718442000);
#6=IFCCARTESIANPOINT((0.,0.,0.));
#7=IFCDIRECTION((0.,0.,1.));
#8=IFCDIRECTION((1.,0.,0.));
#9=IFCAXIS2PLACEMENT3D(#6,#7,#8);
#10=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#9,$);
#11=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#12=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#13=IFCSIUNIT(*,.VOLUMEUNIT.,$,.CUBIC_METRE.);
#14=IFCUNITASSIGNMENT((#11,#12,#13));
#15=IFCPROJECT('3aB1cD2eF3gH4iJ5kL6mN0',#5,'Site Survey Model','LOD 300 coordination model',$,$,$,(#10),#14);
#16=IFCLOCALPLACEMENT($,#9);
#17=IFCSITE('3aB1cD2eF3gH4iJ5kL6mN1',#5,'Demo Site',$,$,#16,$,$,.ELEMENT.,(55,57,0,0),(-3,11,0,0),0.,$,$);
#18=IFCLOCALPLACEMENT(#16,#9);
#19=IFCBUILDING('3aB1cD2eF3gH4iJ5kL6mN2',#5,'Demo Building',$,$,#18,$,$,.ELEMENT.,$,$,$);
#20=IFCLOCALPLACEMENT(#18,#9);
#21=IFCBUILDINGSTOREY('3aB1cD2eF3gH4iJ5kL6mN3',#5,'Ground Floor',$,$,#20,$,$,.ELEMENT.,0.);
#22=IFCRELAGGREGATES('3aggr00000000000000001',#5,$,$,#15,(#17));
#23=IFCRELAGGREGATES('3aggr00000000000000002',#5,$,$,#17,(#19));
#24=IFCRELAGGREGATES('3aggr00000000000000003',#5,$,$,#19,(#21));
#30=IFCLOCALPLACEMENT(#20,#9);
#31=IFCWALLSTANDARDCASE('3wall000000000000000X1',#5,'External Wall - South',$,$,#30,$,$,.STANDARD.);
#32=IFCLOCALPLACEMENT(#20,#9);
#33=IFCSLAB('3slab000000000000000X2',#5,'Ground Floor Slab',$,$,#32,$,$,.FLOOR.);
#40=IFCRELCONTAINEDINSPATIALSTRUCTURE('3cont0000000000000001',#5,$,$,(#31,#33),#21);
ENDSEC;
END-ISO-10303-21;
